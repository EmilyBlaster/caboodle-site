# ============================================================================
# Netlify _headers file — cache-control for caboodle-site
#
# Biggest bandwidth saver on the site. Tells browsers + Netlify's CDN how
# long they can reuse a file before re-downloading. A visitor who comes
# back in a week pulls ~0 bytes for most assets instead of ~10 MB.
#
# Ordering rule: more specific paths go above less specific ones.
# ============================================================================

# ─── Immutable assets: fonts, images, videos, 3D ────────────────────────────
# These files rarely change, and when they do, we can cache-bust by renaming.
# 1 year + immutable = browser reuses the cached copy with zero revalidation.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ─── CSS + JS: always revalidate so edits go live immediately ───────────────
# These files change often during active development and their URLs stay the
# same. max-age=0 + must-revalidate makes the browser check for a new version
# on every load. Netlify answers with a tiny 304 (Not Modified) when nothing
# changed, so the bandwidth cost is negligible — but a real edit reaches every
# visitor on their next reload instead of being stuck behind an hour-long cache.

/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/script.js
  Cache-Control: public, max-age=0, must-revalidate

# ─── HTML pages: short cache, always check for updates ──────────────────────
# You want content changes to go live immediately, so pages revalidate often.

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# ─── Security headers (applies to everything) ───────────────────────────────

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
